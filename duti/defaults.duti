# Default apps, applied with: duti ~/dotfiles/duti/defaults.duti
# (install.sh runs this on macOS). Format: <bundle id> <UTI or .ext> <role>
# Find an app's bundle id: osascript -e 'id of app "Name"'
# Check a type's handler: duti -x md

# --- Code and plain text -> VS Code -----------------------------------------
com.microsoft.VSCode  public.plain-text  all
com.microsoft.VSCode  .txt       all
com.microsoft.VSCode  .md        all
com.microsoft.VSCode  .markdown  all
com.microsoft.VSCode  .json      all
com.microsoft.VSCode  .jsonc     all
com.microsoft.VSCode  .yaml      all
com.microsoft.VSCode  .yml       all
com.microsoft.VSCode  .toml      all
com.microsoft.VSCode  .ini       all
com.microsoft.VSCode  .conf      all
com.microsoft.VSCode  .env       all
com.microsoft.VSCode  .xml       all
com.microsoft.VSCode  .svg       all
com.microsoft.VSCode  .css       all
com.microsoft.VSCode  .scss      all
com.microsoft.VSCode  .sh        all
com.microsoft.VSCode  .bash      all
com.microsoft.VSCode  .zsh       all
com.microsoft.VSCode  .fish      all
com.microsoft.VSCode  .py        all
com.microsoft.VSCode  .rb        all
com.microsoft.VSCode  .js        all
com.microsoft.VSCode  .mjs       all
com.microsoft.VSCode  .cjs       all
com.microsoft.VSCode  .jsx       all
com.microsoft.VSCode  .ts        all
com.microsoft.VSCode  .tsx       all
com.microsoft.VSCode  .lua       all
com.microsoft.VSCode  .go        all
com.microsoft.VSCode  .rs        all
com.microsoft.VSCode  .c         all
com.microsoft.VSCode  .h         all
com.microsoft.VSCode  .cpp       all
com.microsoft.VSCode  .hpp       all
com.microsoft.VSCode  .swift     all
com.microsoft.VSCode  .java      all
com.microsoft.VSCode  .kt        all
com.microsoft.VSCode  .sql       all
com.microsoft.VSCode  .dart      all

# --- Runnable scripts -> Ghostty --------------------------------------------
# .command/.tool and extensionless executables run in a terminal when
# double-clicked. (ssh:// stays with Terminal.app: Ghostty has no URL handler.)
com.mitchellh.ghostty  com.apple.terminal.shell-script  all
com.mitchellh.ghostty  .command  all
com.mitchellh.ghostty  .tool     all
com.mitchellh.ghostty  public.unix-executable  shell

# --- Mail -> Zen ------------------------------------------------------------
# The default *browser* (http/https) can't be set from a script: macOS
# requires the user to confirm it (duti fails with error -54). Set it in
# System Settings > Desktop & Dock > Default web browser (currently Zen).
app.zen-browser.zen  mailto
