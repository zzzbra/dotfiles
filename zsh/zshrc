# User configuration

# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
# How to read this section:
# - `PATH="X:$PATH"` puts X at the FRONT, so for those lines the one further
#   down wins. `PATH="$PATH:X"` puts X at the BACK (a fallback that never
#   shadows anything).
# - Each entry says why it's here and when it can go. When removing one,
#   check `which -a <tool>` first; most are guarded by [[ -d ]], so a missing
#   dir is a no-op, not an error.
# - Only interactive shells read .zshrc. Scripts and LaunchAgents get the bare
#   system PATH (the tmux LaunchAgent sets its own). A proposal to move PATH
#   into .zprofile lives on the Notion task "Make dotfiles Mac + Linux
#   operable (portable tool layer)".
# - Not everything is here: further down, `mise activate` prepends the
#   active python/node/ruby, and opencode and OpenClaw prepend their dirs, so
#   they beat all of the entries below.

# Reset to a known base so re-sourcing (`reload`) and nested shells don't
# pile up duplicates. Side effect: discards anything the terminal added
# (see the Ghostty entry below).
# /usr/local/bin goes LAST: since Intel Homebrew was retired (2026-11-15) it
# only holds third-party links (Docker Desktop, aws, gcm, ollama), and those
# should never shadow a system or Homebrew binary.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin"

# Homebrew. shellenv prepends its bin/sbin, so native brew wins over
# /usr/local/bin. Native arm64 only (Intel Homebrew retired 2026-11-15).
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ~/.local/bin: personal scripts (symlinked from dotfiles/bin via
# symlinks.conf) and self-updating standalone installs (claude, poetry).
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
# ~/.cargo/bin: rustup's toolchain (native aarch64 host) and `cargo install`ed
# tools. It's ahead of brew, so anything installed here shadows brew's copy.
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"
# ~/go/bin: `go install`ed tools (Go itself comes from mise; GOBIN is left
# unset so installs survive Go upgrades). Appears after the first go install.
[[ -d "$HOME/go/bin" ]] && export PATH="$HOME/go/bin:$PATH"
# /opt/X11/bin: XQuartz (X11 apps on macOS). Remove with XQuartz.
[[ -d "/opt/X11/bin" ]] && export PATH="/opt/X11/bin:$PATH"
# Ghostty's CLI (`ghostty +list-themes` etc.) lives inside the app bundle. Ghostty
# adds it to PATH itself, but the PATH reset above discards that, and shells in
# the LaunchAgent-started tmux never had it, so add it explicitly (last: it's a
# convenience, nothing should be shadowed by it).
[[ -x "/Applications/Ghostty.app/Contents/MacOS/ghostty" ]] && export PATH="$PATH:/Applications/Ghostty.app/Contents/MacOS"

# Java: the first openjdk found. Brew's openjdk is keg-only (not linked into
# brew's bin), so it needs adding by hand.
for dir in /opt/homebrew/opt/openjdk*/bin(N); do
    if [[ -d "$dir" ]]; then
        export PATH="$dir:$PATH"
        break
    fi
done

# fvm (brew): ~/fvm/default/bin is the global Flutter/Dart SDK picked by
