# ssh: announce a universally-present terminal to remotes.
# Inside tmux, $TERM is "tmux-256color". SSH copies the local $TERM into the
# remote pty request, so the remote host is told its terminal is tmux-256color.
# Minimal/embedded boxes (e.g. the NAS) ship a sparse terminfo DB without that
# entry, so readline/editors there can't look up key capabilities (kbs =
# Backspace, kdch1 = Delete) and those keys break. We downgrade *only the
# outgoing* TERM to screen-256color: it's in essentially every terminfo DB, and
# it's the correct match because keys flow through tmux, whose terminal model is
# screen-derived. Local tmux/nvim keep tmux-256color (italics/undercurl/truecolor
# untouched). Non-tmux shells already report a universal TERM, so we leave them
# alone. Set-once policy: every bootstrapped machine inherits this; no per-remote
# `tic` provisioning required. See commit for full rationale.
ssh() {
  case "$TERM" in
    tmux*) TERM=screen-256color command ssh "$@" ;;
    *)     command ssh "$@" ;;
  esac
}

# mise: sole owner of what python3, node and ruby mean in a shell (replaced
# pyenv, nvm and rbenv, 2026-11-15). Global versions: config/mise/config.toml;
# a project's mise.toml, .python-version, .nvmrc or .ruby-version wins inside
# it. No shims: a prompt hook puts the active versions' bin dirs on PATH.
# Python policy: docs/python-policy.md. Check: python-doctor
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

if [[ $PROMPT_ENGINE == starship ]] && command -v starship >/dev/null 2>&1; then
    source "${${(%):-%x}:A:h}/starship.zsh"
else
    source ~/powerlevel10k/powerlevel10k.zsh-theme

    # To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
    [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
    # Theme-proof colours on top of it (dotfiles/zsh/p10k-colors.zsh).
    source "${${(%):-%x}:A:h}/p10k-colors.zsh"
fi


